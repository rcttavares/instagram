# Local MongoDB via docker compose (see backend/docker-compose.yml):
MONGO_URL=mongodb://localhost:27017/instagram
# Or MongoDB Atlas:
# MONGO_URL=mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority
PORT=3333

# Cloudinary (image storage — see https://cloudinary.com/console for these values):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
